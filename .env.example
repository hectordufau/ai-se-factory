# OpenCode Zen (primary LLM gateway) — OpenAI-compatible
# Key is resolved from ~/.local/share/opencode/auth.json by default.
# Override here if needed:
# OPENCODE_ZEN_KEY=sk-...
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_ZEN_MODEL=opencode/big-pickle

# Optional secondary provider (model-judgment demos only)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
